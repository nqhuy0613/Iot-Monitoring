    "name": "IoT Monitoring Backend",
    "description": "Collection kiểm thử các REST API của dự án IoT Monitoring. Chạy request Login, sao chép token nhận được và dán vào Authorization > Bearer Token của collection trước khi chạy các request còn lại.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "PASTE_ACCESS_TOKEN_HERE",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"test123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:8888/api/auth/login",
              "host": [
                "http://localhost:8888"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Đăng nhập bằng tài khoản mẫu. Sau khi nhận response, sao chép token và dán vào Authorization > Bearer Token của collection."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response contains token and user', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.token).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.user).to.include.all.keys('id', 'username', 'fullName');",
                  "    pm.expect(body.user.username).to.eql('testuser');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
