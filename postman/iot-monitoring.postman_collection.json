        {
          "name": "Get Sensor Chart",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8888/api/sensor-data/chart",
              "host": [
                "http://localhost:8888"
              ],
              "path": [
                "api",
                "sensor-data",
                "chart"
              ]
            },
            "description": "Lấy tối đa 15 điểm gần nhất của từng loại cảm biến."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Chart contains three sensor arrays', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.temperature).to.be.an('array');",
                  "    pm.expect(body.humidity).to.be.an('array');",
                  "    pm.expect(body.light).to.be.an('array');",
                  "    pm.expect(body.temperature.length).to.be.at.most(15);",
                  "    pm.expect(body.humidity.length).to.be.at.most(15);",
                  "    pm.expect(body.light.length).to.be.at.most(15);",
                  "});"
                ]
              }
            }
          ]
        },
